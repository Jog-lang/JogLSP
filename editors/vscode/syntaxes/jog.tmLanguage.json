{
  "scopeName": "source.jog",
  "name": "Jog",
  "patterns": [
    { "include": "#comment-line" },
    { "include": "#comment-block" },
    { "include": "#string" },
    { "include": "#attribute" },
    { "include": "#function" },
    { "include": "#keyword" },
    { "include": "#support-type" },
    { "include": "#support-function" },
    { "include": "#number" }
  ],
  "repository": {
    "doc-tags": {
      "patterns": [
        {
          "match": "(@param)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.documentation.jog" },
            "2": { "name": "variable.other.documentation.jog" }
          }
        },
        {
          "match": "(@(?:return|context|throws|param))\\b",
          "name": "keyword.other.documentation.jog"
        },
        {
          "match": "(@[A-Za-z_][A-Za-z0-9_]*)",
          "name": "keyword.other.documentation.jog"
        }
      ]
    },
    "comment-line": {
      "name": "comment.line.double-slash.jog",
      "begin": "//",
      "end": "$",
      "patterns": [
        { "include": "#doc-tags" }
      ]
    },
    "comment-block": {
      "name": "comment.block.jog",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        { "include": "#comment-block" },
        { "include": "#doc-tags" }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.other.hex.jog",
          "begin": "\\bx\"",
          "end": "\""
        },
        {
          "name": "string.quoted.other.c.jog",
          "begin": "\\bc\"",
          "end": "\"|\\n",
          "applyEndPatternLast": true,
          "patterns": [
            { "name": "constant.character.escape.jog", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.other.raw.jog",
          "begin": "`",
          "end": "`"
        },
        {
          "name": "string.quoted.single.jog",
          "begin": "'",
          "end": "'|\\n",
          "applyEndPatternLast": true,
          "patterns": [
            { "name": "constant.character.escape.jog", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.double.jog",
          "begin": "\"",
          "end": "\"|\\n",
          "applyEndPatternLast": true,
          "patterns": [
            { "name": "constant.character.escape.jog", "match": "\\\\." },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.jog",
      "begin": "\\$\\{",
      "end": "\\}",
      "applyEndPatternLast": true,
      "patterns": [
        { "include": "#brace" },
        { "include": "$self" }
      ]
    },
    "brace": {
      "begin": "\\{",
      "end": "\\}",
      "applyEndPatternLast": true,
      "patterns": [
        { "include": "#brace" },
        { "include": "$self" }
      ]
    },
    "attribute": {
      "match": "@[A-Za-z_][A-Za-z0-9_]*",
      "name": "entity.name.tag.jog"
    },
    "function": {
      "match": "\\bfn\\s+(?:\\*\\s*)?(?:[A-Za-z_][A-Za-z0-9_]*\\s*\\.)?([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.function.jog" }
      }
    },
    "keyword": {
      "match": "\\b(fn|var|val|type|struct|interface|enum|if|else|when|for|in|break|continue|return|defer|errdefer|go|yield|with|context|private|import|as|is|null|true|false|bytes|op|escaping|const|extern|expect|actual|quote)\\b",
      "name": "keyword.control.jog"
    },
    "support-type": {
      "match": "\\b(Dispatcher|byte|bool|u16|u32|u64|i32|i64|usize|str|void)\\b",
      "name": "support.type.jog"
    },
    "support-function": {
      "match": "\\b(dispatcher_io|dispatcher_single|dispatcher_pool|dispatcher_new|dispatcher_get|coro_drain|coro_alive|coro_id|coro_park|coro_unpark|spawn|sleep_ms|print_tid|worker_id|gettid|print|alloc)\\b",
      "name": "support.function.jog"
    },
    "number": {
      "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\\b",
      "name": "constant.numeric.jog"
    }
  }
}
