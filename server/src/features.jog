// P4 request handlers: document symbols, hover, definition, completion.
// Positions use the same UTF-16 helpers as diagnostics (pos.jog).

import jogc.src.frontend
import std.list as lists
import std.mem
import std.strbuilder

fn symbol_kind_code(kind: str): i64 {
    return when kind {
        "namespace" -> 3
        "enum" -> 10
        "interface" -> 11
        "function" -> 12
        "variable" -> 13
        "constant" -> 14
        "struct" -> 23
        "type" -> 26
        "context" -> 13
        else -> 12
    }
}

fn position_params(params: *Json): (str, i64, i64, bool) with (a: mem.Allocator) {
    var (doc, dok) = params.field("textDocument")
    if !dok {
        return "", 0, 0, false
    }
    var (uri, uok) = doc.str_field("uri")
    var (pos, pok) = params.field("position")
    if !uok || !pok {
        return "", 0, 0, false
    }
    var (line, lok) = pos.int_field("line")
    var (character, cok) = pos.int_field("character")
    if !lok || !cok {
        return "", 0, 0, false
    }
    return uri, line, character, true
}

fn lsp_to_compiler(text: str, lsp_line: i64, lsp_character: i64): (i64, i64) {
    val line = lsp_line + 1
    val (view, ok) = line_view_at(text, line)
    if !ok {
        return line, lsp_character + 1
    }
    val raw = str_bytes(view)
    var i: usize = 0
    var units: usize = 0
    val want = lsp_character as usize
    for i < raw.len && units < want {
        val (adv, u) = utf8_span(raw, i)
        if adv == 0 {
            break
        }
        i = i + adv
        units = units + u
    }
    return line, (i as i64) + 1
}

fn line_start_utf16(text: str, line: i64, byte_col: i64): i64 {
    val (view, ok) = line_view_at(text, line)
    if !ok {
        if byte_col > 0 {
            return byte_col - 1
        }
        return 0
    }
    var idx: usize = 0
    if byte_col > 0 {
        idx = (byte_col - 1) as usize
    }
    return utf16_column(str_bytes(view), idx) as i64
}

fn *Server.analyze_flags(path: str): lists.List<str> with (a: mem.Allocator) {
    var flags: lists.List<str>
    val root = module_root_of(path)
    if root.len > 0 && mod_has_require(root) {
        val tool = resolve_jog_build(self.jog)
        var (raw, err, ok) = fetch_module_flags(root, tool)
        if ok {
            flags = module_flag_values(raw)
            free_strs(&raw)
        } else {
            free_str(err)
        }
        free_str(tool)
    }
    free_str(root)
    return flags
}

fn *Server.on_document_symbol(id: *Json, params: *Json, out: *strbuilder.StrBuilder) with (a: mem.Allocator) {
    var empty = j_arr()
    var (doc, dok) = params.field("textDocument")
    if !dok {
        emit_result(out, id, &empty)
        empty.release()
        return
    }
    var (uri, uok) = doc.str_field("uri")
    if !uok {
        emit_result(out, id, &empty)
        empty.release()
        return
    }
    var (text, _, found) = self.text_of(uri)
    if !found {
        emit_result(out, id, &empty)
        empty.release()
        return
    }
    var (path, pok) = uri_to_path(uri)
    if !pok {
        path = copy_str(uri)
    }
    var syms = frontend.file_symbols(path, text)
    var arr = j_arr()
    var i: usize = 0
    for i < syms.len {
        val s = syms.get(i)
        var start_line: i64 = 0
        if s.line > 0 {
            start_line = s.line - 1
        }
        var end_line: i64 = start_line
        if s.end_line > 0 {
            end_line = s.end_line - 1
        }
        val start_col = line_start_utf16(text, s.line, s.column)
        val end_col = line_start_utf16(text, s.end_line, s.end_column)
        var start = j_obj()
        start.put_int("line", start_line)
        start.put_int("character", start_col)
        var endp = j_obj()
        endp.put_int("line", end_line)
        endp.put_int("character", end_col)
        var range = j_obj()
        range.put("start", start)
        range.put("end", endp)
        var sel_start = j_obj()
        sel_start.put_int("line", start_line)
        sel_start.put_int("character", start_col)
        var sel_end = j_obj()
        sel_end.put_int("line", start_line)
        sel_end.put_int("character", start_col + (s.name.len as i64))
        var sel = j_obj()
        sel.put("start", sel_start)
        sel.put("end", sel_end)
        var one = j_obj()
        one.put_str("name", s.name)
        one.put_int("kind", symbol_kind_code(s.kind))
        one.put("range", range)
        one.put("selectionRange", sel)
        arr.items.push(one)
        i = i + 1
    }
    frontend.free_symbols(&syms)
    free_str(path)
    emit_result(out, id, &arr)
    arr.release()
    empty.release()
}

fn *Server.on_hover(id: *Json, params: *Json, out: *strbuilder.StrBuilder) with (a: mem.Allocator) {
    var none = j_null()
    var (uri, lsp_line, lsp_col, ok) = position_params(params)
    if !ok {
        emit_result(out, id, &none)
        return
    }
    var (text, _, found) = self.text_of(uri)
    if !found {
        emit_result(out, id, &none)
        return
    }
    var (path, pok) = uri_to_path(uri)
    if !pok {
        emit_result(out, id, &none)
        return
    }
    val (line, column) = lsp_to_compiler(text, lsp_line, lsp_col)
    var flags = self.analyze_flags(path)
    var (paths, texts) = self.override_lists()
    val hover = frontend.hover_at(path, flags.items(), paths.items(), texts.items(), path, line, column)
    free_strs(&flags)
    free_strs(&paths)
    free_strs(&texts)
    free_str(path)
    if hover.len == 0 {
        emit_result(out, id, &none)
        free_str(hover)
        return
    }
    var contents = j_obj()
    contents.put_str("kind", "markdown")
    contents.put_str("value", hover)
    var result = j_obj()
    result.put("contents", contents)
    emit_result(out, id, &result)
    result.release()
    free_str(hover)
}

fn *Server.on_definition(id: *Json, params: *Json, out: *strbuilder.StrBuilder) with (a: mem.Allocator) {
    var none = j_null()
    var (uri, lsp_line, lsp_col, ok) = position_params(params)
    if !ok {
        emit_result(out, id, &none)
        return
    }
    var (text, _, found) = self.text_of(uri)
    if !found {
        emit_result(out, id, &none)
        return
    }
    var (path, pok) = uri_to_path(uri)
    if !pok {
        emit_result(out, id, &none)
        return
    }
    val (line, column) = lsp_to_compiler(text, lsp_line, lsp_col)
    var flags = self.analyze_flags(path)
    var (paths, texts) = self.override_lists()
    val loc = frontend.definition_at(path, flags.items(), paths.items(), texts.items(), path, line, column)
    free_strs(&flags)
    free_strs(&paths)
    free_strs(&texts)
    free_str(path)
    if !loc.ok {
        emit_result(out, id, &none)
        return
    }
    val target_uri = path_to_uri(loc.path)
    var start_line: i64 = 0
    var start_col: i64 = 0
    if loc.line > 0 {
        start_line = loc.line - 1
    }
    if loc.column > 0 {
        start_col = loc.column - 1
    }
    var start = j_obj()
    start.put_int("line", start_line)
    start.put_int("character", start_col)
    var endp = j_obj()
    endp.put_int("line", start_line)
    endp.put_int("character", start_col + 1)
    var range = j_obj()
    range.put("start", start)
    range.put("end", endp)
    var result = j_obj()
    result.put_str("uri", target_uri)
    result.put("range", range)
    emit_result(out, id, &result)
    result.release()
    free_str(target_uri)
    free_str(loc.path)
}

fn *Server.on_completion(id: *Json, params: *Json, out: *strbuilder.StrBuilder) with (a: mem.Allocator) {
    var empty = j_arr()
    var (uri, lsp_line, lsp_col, ok) = position_params(params)
    if !ok {
        emit_result(out, id, &empty)
        empty.release()
        return
    }
    var (text, _, found) = self.text_of(uri)
    if !found {
        emit_result(out, id, &empty)
        empty.release()
        return
    }
    var (path, pok) = uri_to_path(uri)
    if !pok {
        emit_result(out, id, &empty)
        empty.release()
        return
    }
    val (line, column) = lsp_to_compiler(text, lsp_line, lsp_col)
    var flags = self.analyze_flags(path)
    var (paths, texts) = self.override_lists()
    var names = frontend.complete_at(path, flags.items(), paths.items(), texts.items(), path, text, line, column)
    free_strs(&flags)
    free_strs(&paths)
    free_strs(&texts)
    free_str(path)
    var arr = j_arr()
    var i: usize = 0
    for i < names.len {
        var one = j_obj()
        one.put_str("label", names.get(i))
        one.put_int("kind", 6)
        arr.items.push(one)
        i = i + 1
    }
    frontend.free_strs(&names)
    emit_result(out, id, &arr)
    arr.release()
    empty.release()
}
