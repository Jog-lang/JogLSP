import std.list as lists
import std.mem
import std.strbuilder

actual fn deps_flags_argv(root: str, tool: str): lists.List<str> with (a: mem.Allocator) {
    var script = strbuilder.empty()
    script.append("cd /d \"")
    script.append(root)
    script.append("\" && \"")
    script.append(tool)
    script.append("\" deps --flags")
    val body = copy_str(script.str())
    script.free()
    var args: lists.List<str>
    args.push(copy_str("cmd.exe"))
    args.push(copy_str("/c"))
    args.push(body)
    return args
}
