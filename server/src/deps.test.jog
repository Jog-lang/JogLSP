import std.fs
import std.mem
import std.os
import std.testing

fn deps_fixture(rel: str): str with (a: mem.Allocator) {
    val exe = os.argv(0)
    val out_dir = parent_dir(exe)
    val root = parent_dir(out_dir)
    val data = fs.join(root, "testdata")
    val deps = fs.join(data, "deps")
    val path = fs.join(deps, rel)
    fs.free_str(data)
    fs.free_str(deps)
    free_str(out_dir)
    free_str(root)
    return path
}

@test
fn path_require_checks_clean() with (t: testing.Testing) {
    with (mem.heap()) {
        val app = deps_fixture("ok/app")
        val file = fs.join(app, "main.jog")
        t.expect(fs.exists(file))
        val src = "import greeter\n\nfn main() {\n    val s = greeter.hello()\n}\n"
        val uri = path_to_uri(file)
        var srv = server_new(jog_bin())
        val init = rpc_body("initialize", 1, true, j_obj())
        free_str(srv.handle(init))
        free_str(init)
        var doc = j_obj()
        doc.put_str("uri", uri)
        doc.put_str("languageId", "jog")
        doc.put_int("version", 1)
        doc.put_str("text", src)
        var open_params = j_obj()
        open_params.put("textDocument", doc)
        val opened = rpc_body("textDocument/didOpen", 0, false, open_params)
        free_str(srv.handle(opened))
        free_str(opened)
        var save_doc = j_obj()
        save_doc.put_str("uri", uri)
        var save_params = j_obj()
        save_params.put("textDocument", save_doc)
        val saved = rpc_body("textDocument/didSave", 0, false, save_params)
        val saved_out = srv.handle(saved)
        var (pub, pok) = read_response(saved_out)
        t.expect(pok)
        var (method, mok) = pub.str_field("method")
        t.expect(mok)
        t.expect(method == "textDocument/publishDiagnostics")
        var (params, pak) = pub.field("params")
        t.expect(pak)
        var (items, iok) = params.field("diagnostics")
        t.expect(iok)
        t.expect(items.items.len == 0)
        pub.release()
        free_str(saved_out)
        free_str(saved)
        srv.release()
        free_str(uri)
        fs.free_str(file)
        free_str(app)
    }
}

@test
fn missing_require_is_diagnostic() with (t: testing.Testing) {
    with (mem.heap()) {
        val app = deps_fixture("missing/app")
        val file = fs.join(app, "main.jog")
        t.expect(fs.exists(file))
        val src = "import gone.x\n\nfn main() {\n}\n"
        val uri = path_to_uri(file)
        var srv = server_new(jog_bin())
        val init = rpc_body("initialize", 1, true, j_obj())
        free_str(srv.handle(init))
        free_str(init)
        var doc = j_obj()
        doc.put_str("uri", uri)
        doc.put_str("languageId", "jog")
        doc.put_int("version", 1)
        doc.put_str("text", src)
        var open_params = j_obj()
        open_params.put("textDocument", doc)
        val opened = rpc_body("textDocument/didOpen", 0, false, open_params)
        free_str(srv.handle(opened))
        free_str(opened)
        var save_doc = j_obj()
        save_doc.put_str("uri", uri)
        var save_params = j_obj()
        save_params.put("textDocument", save_doc)
        val saved = rpc_body("textDocument/didSave", 0, false, save_params)
        val saved_out = srv.handle(saved)
        var (pub, pok) = read_response(saved_out)
        t.expect(pok)
        var (method, mok) = pub.str_field("method")
        t.expect(mok)
        t.expect(method == "textDocument/publishDiagnostics")
        var (params, pak) = pub.field("params")
        t.expect(pak)
        var (items, iok) = params.field("diagnostics")
        t.expect(iok)
        t.expect(items.items.len > 0)
        var diag = items.items.get(0)
        var (message, msg_ok) = diag.str_field("message")
        t.expect(msg_ok)
        t.expect(message.len > 0)
        pub.release()
        free_str(saved_out)
        free_str(saved)
        srv.release()
        free_str(uri)
        fs.free_str(file)
        free_str(app)
    }
}

@test
fn run_analyze_uses_module_flags() with (t: testing.Testing) {
    with (mem.heap()) {
        val app = deps_fixture("ok/app")
        val file = fs.join(app, "main.jog")
        var srv = server_new(jog_bin())
        var (diags, ok) = srv.run_analyze(file)
        t.expect(ok)
        t.expect(diags.len == 0)
        free_diags(&diags)
        fs.free_str(file)
        free_str(app)

        val miss = deps_fixture("missing/app")
        val bad = fs.join(miss, "main.jog")
        var (bad_diags, bok) = srv.run_analyze(bad)
        t.expect(bok)
        t.expect(bad_diags.len > 0)
        free_diags(&bad_diags)
        fs.free_str(bad)
        free_str(miss)
        srv.release()
    }
}
