// On save, when jog.mod has require lines, the server asks jog-build for
// --module flags (deps --flags) and passes them to jog check. jog-build
// reads the module from the process cwd, and std.proc.run cannot set cwd,
// so the host files build a small shell/cmd argv that cds first.

import std.fs
import std.list as lists
import std.mem
import std.os
import std.proc

expect fn deps_flags_argv(root: str, tool: str): lists.List<str> with (a: mem.Allocator)

fn is_ascii_space(c: u8): bool {
    return c == ' ' as u8 || c == '\t' as u8 || c == '\n' as u8 || c == '\r' as u8
}

fn trim_ascii(text: str): str {
    var start: usize = 0
    var stop = text.len
    for start < stop && is_ascii_space(text.ptr[start]) {
        start = start + 1
    }
    for stop > start && is_ascii_space(text.ptr[stop - 1]) {
        stop = stop - 1
    }
    return view_range(text, start, stop)
}

fn ends_with_str(text: str, suffix: str): bool {
    if text.len < suffix.len {
        return false
    }
    return view_range(text, text.len - suffix.len, text.len) == suffix
}

fn parent_dir(path: str): str with (a: mem.Allocator) {
    var i = path.len
    for i > 0 {
        i = i - 1
        val c = path.ptr[i]
        if c == '/' as u8 || c == '\\' as u8 {
            if i == 0 {
                return copy_str(view_range(path, 0, 1))
            }
            return copy_str(view_range(path, 0, i))
        }
    }
    return ""
}

fn module_root_of(file_path: str): str with (a: mem.Allocator) {
    var dir = parent_dir(file_path)
    if dir.len == 0 {
        return ""
    }
    for {
        val mod_path = fs.join(dir, "jog.mod")
        val found = fs.exists(mod_path)
        fs.free_str(mod_path)
        if found {
            return dir
        }
        val up = parent_dir(dir)
        if up.len == 0 || up == dir {
            free_str(up)
            free_str(dir)
            return ""
        }
        free_str(dir)
        dir = up
    }
}

fn line_is_require(line: str): bool {
    val t = trim_ascii(line)
    if !starts_with(t, "require") {
        return false
    }
    if t.len == 7 {
        return true
    }
    val next = t.ptr[7]
    return next == ' ' as u8 || next == '\t' as u8
}

fn mod_has_require(root: str): bool with (a: mem.Allocator) {
    val mod_path = fs.join(root, "jog.mod")
    var (data, err) = fs.read_all(mod_path)
    fs.free_str(mod_path)
    if err != null {
        return false
    }
    defer a.free(data)
    val text: str = data
    var start: usize = 0
    var i: usize = 0
    for i <= text.len {
        val at_end = i == text.len
        var is_nl = false
        if !at_end && text.ptr[i] == '\n' as u8 {
            is_nl = true
        }
        if at_end || is_nl {
            var stop = i
            if stop > start && text.ptr[stop - 1] == '\r' as u8 {
                stop = stop - 1
            }
            if stop > start {
                val line = view_range(text, start, stop)
                if line_is_require(line) {
                    return true
                }
            }
            start = i + 1
        }
        if at_end {
            break
        }
        i = i + 1
    }
    return false
}

fn resolve_jog_build(jog: str): str with (a: mem.Allocator) {
    var (env, ok) = os.env("JOG_BUILD")
    if ok && env.len > 0 && fs.exists(env) {
        return copy_str(env)
    }
    val dir = parent_dir(jog)
    if dir.len > 0 {
        val unix = fs.join(dir, "jog-build")
        if fs.exists(unix) {
            free_str(dir)
            return unix
        }
        fs.free_str(unix)
        val win = fs.join(dir, "jog-build.exe")
        if fs.exists(win) {
            free_str(dir)
            return win
        }
        fs.free_str(win)
        free_str(dir)
    }
    if ends_with_str(jog, ".exe") || ends_with_str(jog, ".EXE") {
        return copy_str("jog-build.exe")
    }
    return copy_str("jog-build")
}

fn push_flag_lines(text: str, flags: *lists.List<str>) with (a: mem.Allocator) {
    var start: usize = 0
    var i: usize = 0
    for i <= text.len {
        val at_end = i == text.len
        var is_nl = false
        if !at_end && text.ptr[i] == '\n' as u8 {
            is_nl = true
        }
        if at_end || is_nl {
            var stop = i
            if stop > start && text.ptr[stop - 1] == '\r' as u8 {
                stop = stop - 1
            }
            if stop > start {
                val line = trim_ascii(view_range(text, start, stop))
                if line.len > 0 {
                    flags.push(copy_str(line))
                }
            }
            start = i + 1
        }
        if at_end {
            break
        }
        i = i + 1
    }
}

fn trim_message(text: str): str with (a: mem.Allocator) {
    val t = trim_ascii(text)
    if t.len == 0 {
        return copy_str("jog-build deps --flags failed")
    }
    var stop = t.len
    var i: usize = 0
    for i < t.len {
        if t.ptr[i] == '\n' as u8 || t.ptr[i] == '\r' as u8 {
            stop = i
            break
        }
        i = i + 1
    }
    return copy_str(trim_ascii(view_range(t, 0, stop)))
}

// ok means stdout held --module flags. On failure err is a short message
// from stderr (or a fixed fallback). flags is empty when !ok.
fn fetch_module_flags(root: str, tool: str): (lists.List<str>, str, bool) with (a: mem.Allocator) {
    var empty: lists.List<str>
    var argv = deps_flags_argv(root, tool)
    var (output, err) = proc.run(argv.items())
    free_strs(&argv)
    defer proc.free_output(output)
    if err != null {
        return empty, copy_str("cannot run jog-build deps --flags"), false
    }
    if output.code != 0 {
        val err_text: str = output.stderr
        return empty, trim_message(err_text), false
    }
    var flags: lists.List<str>
    val out_text: str = output.stdout
    push_flag_lines(out_text, &flags)
    return flags, "", true
}

fn synthetic_deps_diag(path: str, message: str): Diag with (a: mem.Allocator) {
    var d = Diag()
    d.path = copy_str(path)
    d.line = 1
    d.column = 1
    d.severity = copy_str("error")
    d.message = copy_str(message)
    return d
}
